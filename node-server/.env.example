# Copy these values into the deployment platform's secret manager.
# Do not put real secrets in this file or commit a populated .env file.

# Required for email/password registration. Use an SMTP account you control.
# Registration fails closed until all four values are configured.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=mailer@example.com
SMTP_PASS=replace_with_smtp_app_password
SMTP_FROM="Obsidian Pro <mailer@example.com>"
# Set to true only after SMTP is configured and tested. It is off by default.
REQUIRE_EMAIL_VERIFICATION=false

# Crypto Pay API app created through @CryptoBot -> Crypto Pay -> Create App.
CRYPTO_PAY_API_TOKEN=replace_with_a_new_crypto_pay_app_token
CRYPTO_PAY_WEBHOOK_SECRET=replace_with_at_least_32_random_characters
CRYPTO_PAY_TESTNET=true

# Official merchant wallet and optional authenticated TronGrid access.
PAYMENT_TRC20_WALLET=replace_with_your_tron_address
TRONGRID_API_KEY=replace_with_your_trongrid_api_key

# USDT BEP-20 on BNB Smart Chain. These defaults are built in; override them
# here only when changing the merchant wallet or RPC provider.
# Required to enable BEP-20. Set this to a wallet you control.
# PAYMENT_BEP20_WALLET=0xYOUR_OWN_BSC_WALLET
BSC_RPC_URL=https://bsc-rpc.publicnode.com

# Optional shared location for promo definitions and activation reservations.
# PROMOS_FILE=C:\secure-data\obsidian\promos.json

# Telegram application/admin bots. Rotate the previously exposed tokens first.
TELEGRAM_BOT_TOKEN=replace_with_a_new_main_bot_token
TELEGRAM_BOT_USERNAME=ObsidianScreenerBot
ADMIN_BOT_TOKEN=replace_with_a_new_admin_bot_token
ADMIN_CHAT_ID=replace_with_the_admin_chat_id

# High-entropy secret for administrative HTTP endpoints.
ADMIN_API_SECRET=replace_with_at_least_32_random_characters

# Set to the number of trusted reverse-proxy hops; leave unset for direct access.
TRUST_PROXY_HOPS=1

# Optional. Keep outside a public web root and back it up securely.
# PAYMENT_DATA_DIR=C:\secure-data\obsidian

# Public HTTPS destination shown after Crypto Pay completes.
PAYMENT_SUCCESS_URL=https://t.me/ObsidianScreenerBot

# Optional secure SSH deployment. Use an unprivileged account and pin the host.
DEPLOY_HOST=replace_with_server_hostname
DEPLOY_USER=obsidian-deploy
DEPLOY_SSH_KEY_PATH=C:\secure-keys\obsidian-deploy
DEPLOY_SSH_KEY_PASSPHRASE=replace_with_key_passphrase
DEPLOY_HOST_FINGERPRINT_SHA256=replace_with_pinned_sha256_fingerprint
DEPLOY_REMOTE_DIR=/srv/obsidian/node-server
DEPLOY_PM2_PROCESS=server
# ─── Density engine (order-book densities) ────────────────────────────────────
# The engine polls every symbol on all 11 exchanges continuously. Coverage is
# bounded by a per-exchange token bucket, not by a batch size, so the knobs below
# control refresh cadence and strictness rather than how many symbols are seen.

# Refresh cadence per liquidity tier (ms). Tier 1 = 30 most liquid symbols.
WALL_TIER1_MS=12000
WALL_TIER2_MS=30000
WALL_TIER3_MS=75000
WALL_TIER4_MS=180000
# Global multiplier on every exchange's REST budget. Lower it if you see 429/418.
WALL_RATE_SCALE=1.0
WALL_REQUEST_TIMEOUT_MS=7000
# How often a new snapshot is pushed to clients. Each publish is a visible change
# on the map, so pushing faster mainly makes it look unstable.
WALL_PUBLISH_INTERVAL_MS=4000

# Scan band around the mid price, in percent.
WALL_MIN_DIST_PCT=0.03
WALL_MAX_DIST_PCT=5.0

# ── Strictness ────────────────────────────────────────────────────────────────
# All relative (ratios), so they behave identically for BTC and for a micro-cap.
# Raise to show fewer, stronger densities; lower to see more.
#   MIN_SIGNIFICANCE - composite of all five signals, 0..1
#   MIN_Z            - robust log Z-score against the book's own distribution
#   MIN_DOMINANCE    - how many times larger than neighbouring levels
#   MIN_DEPTH_SHARE  - share of the whole side's depth inside the scan band
#   MIN_VOL_MINUTES  - size expressed in minutes of the coin's average volume
WALL_MIN_SIGNIFICANCE=0.40
WALL_MIN_Z=1.9
WALL_MIN_DOMINANCE=3.2
WALL_MIN_DEPTH_SHARE=0.05
WALL_MIN_VOL_MINUTES=0.8
# Absolute floors, used only to discard dust and dead markets.
WALL_MIN_ABS_USD=50000
WALL_MIN_SYMBOL_VOLUME_USD=2000000

# ── Stability (anti-flicker) ──────────────────────────────────────────────────
# A level must be seen in this many separate polls before it is published at all.
# This is the main defence against one-refresh appearances.
WALL_MIN_CONFIRMATIONS=2
# Quality needed to enter the map, and the fraction of it needed to stay there.
# The gap between them is hysteresis: it stops borderline levels from blinking.
WALL_MIN_QUALITY=0.28
WALL_KEEP_QUALITY_RATIO=0.72

# Snapshot shaping. EX_RESERVE_RATIO is the share of output slots reserved for
# per-exchange round-robin so all 11 venues stay visible.
WALL_MAX_RESULTS=600
WALL_MAX_PER_COIN=3
WALL_EX_RESERVE_RATIO=0.45
WALL_PUBLISH_MIN_SCORE=5.0

WALL_SYMBOL_STALE_MS=900000
WALL_EXCHANGE_CACHE_TTL_MS=300000
WALL_HISTORY_TTL_MS=86400000
WALL_HISTORY_LIMIT=5000

# Production hardening
NODE_ENV=production
# Keep Node private behind nginx; only override after configuring an equivalent
# firewall/reverse-proxy boundary.
BIND_HOST=127.0.0.1
# Optional: allow cross-origin reads of public market data for listed origins only
# CORS_ORIGINS=https://your-domain.tld
# Canonical public origin used by SEO pages and sitemap (no trailing slash).
PUBLIC_SITE_ORIGIN=https://obsidianscreener.com

# Internal Go scanner bind address (loopback only by default)
# SCANNER_ADDR=127.0.0.1:8082
# Set to 1 when running behind nginx/Caddy so rate limits see real client IPs
# TRUST_PROXY_HOPS=1
