+function drawIndicatorCandles(targetCtx, values, start, count, xForIndex, candleWidth, yForValue) {
+  if (!targetCtx || !Array.isArray(values) || count <= 0) return;
+  const theme = window.AppearanceThemes?.get(document.documentElement.dataset.appearanceTheme);
+  const upColor = theme?.up || "#26c97a";
+  const downColor = theme?.down || "#ff4560";
+  const upBorder = theme?.wickUp || upColor;
+  const downBorder = theme?.wickDown || downColor;
+  const dpr = Math.max(1, Math.min(2, window.devicePixelRatio || 1));
+  const bodyWidth = Math.max(1 / dpr, Math.min(7, Math.max(1 / dpr, candleWidth - 2)));
+
+  targetCtx.save();
+  for (let i = 0; i < count; i++) {
+    const index = start + i;
+    const close = Number(values[index]);
+    if (!Number.isFinite(close)) continue;
+    const previous = Number(values[index - 1]);
+    const open = Number.isFinite(previous) ? previous : close;
+    const yOpen = yForValue(open);
+    const yClose = yForValue(close);
+    if (!Number.isFinite(yOpen) || !Number.isFinite(yClose)) continue;
+
+    const rising = close >= open;
+    const rawX = xForIndex(i);
+    const centerX = (Math.round(rawX * dpr) + .5) / dpr;
+    const top = Math.min(yOpen, yClose);
+    const height = Math.max(1 / dpr, Math.abs(yClose - yOpen));
+    const left = Math.round((rawX - bodyWidth / 2) * dpr) / dpr;
+
+    targetCtx.strokeStyle = rising ? upBorder : downBorder;
+    targetCtx.lineWidth = 1 / dpr;
+    targetCtx.beginPath();
+    targetCtx.moveTo(centerX, yOpen);
+    targetCtx.lineTo(centerX, yClose);
+    targetCtx.stroke();
+
+    targetCtx.fillStyle = hexToRgba(rising ? upColor : downColor, 82);
+    targetCtx.fillRect(left, top, bodyWidth, height);
+    targetCtx.strokeStyle = rising ? upBorder : downBorder;
+    targetCtx.strokeRect(left + .5 / dpr, top + .5 / dpr, Math.max(1 / dpr, bodyWidth - 1 / dpr), Math.max(1 / dpr, height - 1 / dpr));
+  }
+  targetCtx.restore();
+}
