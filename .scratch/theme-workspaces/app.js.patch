+
+function loadWorkspaceAppearanceColors() {
+  let saved = {};
+  try { saved = JSON.parse(localStorage.getItem("screener-workspace-colors") || "{}"); } catch (_) {}
+  return { ...getWorkspaceAppearanceDefaults(), ...saved };
+}
+
+function applyWorkspaceAppearanceColors(colors, save = false) {
+  const next = { ...getWorkspaceAppearanceDefaults(), ...(colors || {}) };
+  for (const [key, cssVar] of Object.entries(WORKSPACE_APPEARANCE_FIELDS)) {
+    if (/^#[0-9a-f]{6}$/i.test(next[key] || "")) document.documentElement.style.setProperty(cssVar, next[key]);
+  }
+  window.workspaceAppearanceColors = next;
+  if (save) localStorage.setItem("screener-workspace-colors", JSON.stringify(next));
